              <div
                onClick={() => fileInputRef.current.click()}
                className="aspect-square border-[8px] border-black border-dashed rounded-[60px] flex items-center justify-center cursor-pointer overflow-hidden bg-gray-50 hover:bg-yellow-50 transition-all shadow-inner"
              >
                {newBoard.image ? (
                  <img
                    src={newBoard.image}
                    alt="board"
                    className="w-full h-full object-cover"
                  />
                ) : (
                  <div className="text-center">
                    <FiUploadCloud
                      size={150}
                      className="m-auto text-gray-300"
                    />

                    <p className="font-black text-4xl text-gray-400 mt-8">
                      CHỌN ẢNH XỊN
                    </p>
                  </div>
                )}

                <input
                  type="file"
                  ref={fileInputRef}
                  hidden
                  accept="image/*"
                  onChange={handleBoardImage}
                />
              </div>

              {/* FORM */}
              <div className="flex flex-col gap-10">
                <input
                  placeholder="Địa điểm?"
                  className="w-full border-[6px] border-black p-10 rounded-[35px] font-black text-6xl shadow-inner outline-none"
                  value={newBoard.title}
                  onChange={(e) =>
                    setNewBoard((prev) => ({
                      ...prev,
                      title: e.target.value,
                    }))
                  }
                />

                <textarea
  placeholder="Cảm xúc của bạn..."
  className="w-full border-[6px] border-black p-10 rounded-[35px] font-black text-4xl text-center shadow-inner outline-none resize-none"
  rows="4"
  value={newBoard.feeling}
  onChange={(e) =>
    setNewBoard((prev) => ({
      ...prev,
      feeling: e.target.value,
    }))
  }
/>

{/* EMOJI PICKER */}
<div className="flex flex-wrap gap-4 justify-center bg-yellow-50 border-[5px] border-black rounded-[35px] p-6">
  {["😊", "😢", "🥰", "🤩", "🧘", "🔥", "🍕", "🌈", "🦄"].map(
    (emoji) => (
      <button
        key={emoji}
        type="button"
        onClick={() =>
          setNewBoard((prev) => ({
            ...prev,
            emote: emoji,
          }))
        }
        className={`text-5xl p-4 rounded-2xl border-[4px] transition-all hover:scale-125 ${
          newBoard.emote === emoji
            ? "border-black bg-white scale-110"
            : "border-transparent"
        }`}
      >
        {emoji}
      </button>
    )
  )}
</div>

                <button
                  onClick={handleCreateBoard}
                  className="bg-black text-white py-12 rounded-[45px] font-black text-6xl shadow-[15px_15px_0px_0px_rgba(255,77,77,1)] hover:translate-y-4 hover:shadow-none transition-all mt-6 uppercase italic"
                >
                  Ghim Bài
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

